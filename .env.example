# Postgres (used by docker-compose and the app)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=portfolio_builder
# Host port for the Docker Postgres container (5432 is often taken by a local install)
POSTGRES_PORT=5434

DATABASE_URL=postgresql://postgres:postgres@localhost:5434/portfolio_builder

# Required in production. Generate with: openssl rand -base64 48
JWT_SECRET=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# S3-compatible object storage for file uploads (avatars, covers, certificates)
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# Optional: bucket name (default "media") and public base URL for served files
# (defaults to <AWS_ENDPOINT_URL_S3>/<S3_BUCKET>; set this if you front the bucket with a CDN)
S3_BUCKET=
S3_PUBLIC_BASE_URL=
